# Never put access keys in the public HTML file. This application needs no API key.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
PUBLIC_SITE_URL=https://calypso-games.netlify.app/
# On Render, RENDER_EXTERNAL_URL is supplied automatically instead.
PUBLIC_SERVER_URL=https://YOUR-SERVER-ADDRESS.example/
# Optional comma-separated additional trusted website origins. Never use '*'.
ALLOWED_ORIGINS=
